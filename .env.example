# Copy to .env.local for local development. Never commit real values.
# On Vercel / the worker host, set these in the provider's environment settings.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Storyling

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: used by server actions, webhooks and the worker.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (server-only) ---
OPENAI_API_KEY=
# Optional: organization / project scoping
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# --- Stripe (use test-mode keys outside production) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- PayPal (sandbox outside production) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

# --- Transactional email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Storyling <hello@example.com>"

# --- Background worker ---
# Shared secret for the Vercel Cron fallback endpoint (/api/cron/jobs)
CRON_SECRET=
WORKER_ID=worker-local

# --- Monitoring (optional) ---
SENTRY_DSN=

# --- Tests only: PostgreSQL superuser URL for supabase/tests ---
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/postgres
